<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    
    <!-- Thông tin bản quyền & Metadata -->
    <Company>LMO-LAB</Company>
    <Authors>LMO-LAB</Authors>
    <Product>BambooMintKey Vietnamese Input</Product>
    <Copyright>Copyright © 2026</Copyright>

    <!-- Quản lý phiên bản tập trung (Single Source of Truth) -->
    <VersionPrefix>1.1.4</VersionPrefix>
    <Version>1.1.4</Version>
    <AssemblyVersion>1.1.4.0</AssemblyVersion>
    <FileVersion>1.1.4.0</FileVersion>
    <InformationalVersion>1.1.4</InformationalVersion>
  </PropertyGroup>

  <!--
    Cho phép build các project targeting Windows (net10.0-windows) trên Linux/macOS
    khi build toàn solution bằng IDE (vd Rider). Tránh lỗi NETSDK1100.
    Chỉ áp dụng trên non-Windows; trên Windows không cần thiết.
  -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>