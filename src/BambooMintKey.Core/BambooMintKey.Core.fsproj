<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Domain\Types.fs" />
    <Compile Include="Domain\EngineConfig.fs" />
    <Compile Include="Domain\UnicodeTables.fs" />
    <Compile Include="Domain\HotkeyFormatter.fs" />
    <Compile Include="Domain\IDictionaryService.fs" />
    <Compile Include="Dictionary\FrozenDictionaryService.fs" />
    <Compile Include="Engine\ModifierRules.fs" />
    <Compile Include="Engine\SyllableParser.fs" />
    <Compile Include="Engine\ToneRules.fs" />
    <Compile Include="Engine\WordBuffer.fs" />
    <Compile Include="Engine\EnglishProtection.fs" />
    <Compile Include="Engine\FreeTonePlacement.fs" />
    <Compile Include="Engine\TelexEngine.fs" />
    <Compile Include="Interop\NativeApi.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BambooMintKey.Shared\BambooMintKey.Shared.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Nhúng từ điển MIT/CC0 (tự sinh từ corpus) vào Core assembly để zero-path dependency.
         Không nhúng file GPL (chỉ là corpus reference). -->
    <EmbeddedResource Include="..\..\dicts\vietnamese-syllables-mit.dict"
                      LogicalName="BambooMintKey.Core.Resources.vietnamese-syllables-mit.dict" />
    <EmbeddedResource Include="..\..\dicts\english-20k.dict"
                      LogicalName="BambooMintKey.Core.Resources.english-20k.dict" />
  </ItemGroup>

</Project>
