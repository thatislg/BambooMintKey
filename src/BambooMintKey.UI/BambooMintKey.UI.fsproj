<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="SharedConfig.fs" />
    <Compile Include="TsfBootstrapper.fs" />
    <Compile Include="MainWindow.axaml.fs" />
    <Compile Include="TrayIconManager.fs" />
    <Compile Include="App.axaml.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\publish\win-x64\BambooMintKey.dll')">
    <Content Include="..\..\publish\win-x64\BambooMintKey.dll">
      <Link>BambooMintKey.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\publish\win-x86\BambooMintKey32.dll')">
    <Content Include="..\..\publish\win-x86\BambooMintKey32.dll">
      <Link>BambooMintKey32.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BambooMintKey.Shared\BambooMintKey.Shared.fsproj" />
    <ProjectReference Include="..\BambooMintKey.Core\BambooMintKey.Core.fsproj" />
  </ItemGroup>
</Project>
